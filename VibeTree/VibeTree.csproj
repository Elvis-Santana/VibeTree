  <ItemGroup>
	  <PackageReference Include="BCrypt.Net-Next" Version="4.2.0" />
	  <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="9.0.13" />

	  <PackageReference Include="MySql.Data" Version="9.7.0" />
	  <PackageReference Include="FluentValidation" Version="12.1.1" />
	  <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.15" />
	  <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.15" />
	  <PackageReference Include="Pomelo.EntityFrameworkCore.MySql" Version="9.0.0" />
	  <PackageReference Include="WolverineFx" Version="6.21.0" />
	  <PackageReference Include="WolverineFx.MySql" Version="6.21.0" />
	  <PackageReference Include="WolverineFx.RuntimeCompilation" Version="6.21.0" Condition="'$(Configuration)' == 'Debug'" />

  </ItemGroup>

	<ItemGroup>
		<Compile Update="Internal\Generated\**\*.cs" Watch="false" />
	</ItemGroup>
	
    <ItemGroup>
	    <InternalsVisibleTo Include="VibeTree.Test" />
